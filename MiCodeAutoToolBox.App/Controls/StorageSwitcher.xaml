<UserControl x:Class="MiCodeAutoToolBox.App.Controls.StorageSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Height="120">
    <Border Background="#222" Padding="8" CornerRadius="4">
        <StackPanel>
            <TextBlock Text="存储位置" Foreground="#ccc" FontWeight="Bold" Margin="0,0,0,6"/>
            <ComboBox x:Name="LocationCombo" SelectedIndex="0" Margin="0,0,0,6">
                <ComboBoxItem Content="应用数据 (%APPDATA%)" Tag="AppData"/>
                <ComboBoxItem Content="便携 (程序目录 /data)" Tag="Portable"/>
                <ComboBoxItem Content="自定义路径" Tag="Custom"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,0,6,0"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="ChoosePathButton" Content="选择路径" Width="80" Visibility="Collapsed"/>
                <Button x:Name="ApplyButton" Content="切换" Width="80"/>
                <ProgressBar x:Name="Progress" Width="160" Height="6" Visibility="Collapsed" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CurrentPathText" Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
