<UserControl x:Class="MiCodeAutoToolBox.App.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Height="320">
    <Grid Background="#1e1e1e">
        <Border Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="文本对比" Foreground="#fff" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="FrameworkElement">
                                <Setter Property="Margin" Value="0,0,6,0"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBox Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                        <Button Content="浏览左侧" Width="90" Command="{Binding BrowseLeftCommand}"/>
                        <TextBox Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                        <Button Content="浏览右侧" Width="90" Command="{Binding BrowseRightCommand}"/>
                        <Button Content="对比" Width="80" Command="{Binding DiffCommand}"/>
                        <Button Content="清空" Width="80" Command="{Binding ClearCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DiffResult}" Foreground="#ccc" FontSize="12"/>
                        <CheckBox Content="仅看差异" IsChecked="{Binding OnlyDiffs}" Margin="16,0,0,0" Foreground="#e8e8e8"/>
                    </StackPanel>

                    <Grid Margin="0,8,0,0" Height="400">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="#333" BorderThickness="1" Margin="0,0,6,0" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="LeftScroll" ScrollChanged="OnLeftScrollChanged">
                                <ItemsControl ItemsSource="{Binding FilteredPairs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LineNumber}" Foreground="#999" Width="40"/>
                                                <TextBlock Text="{Binding Left}" TextWrapping="Wrap" Width="Auto">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#e8e8e8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                                    <Setter Property="Foreground" Value="#e25858" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="#333" BorderThickness="1" Margin="6,0,0,0" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="RightScroll" ScrollChanged="OnRightScrollChanged">
                                <ItemsControl ItemsSource="{Binding FilteredPairs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LineNumber}" Foreground="#999" Width="40"/>
                                                <TextBlock Text="{Binding Right}" TextWrapping="Wrap" Width="Auto">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#e8e8e8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                                                    <Setter Property="Foreground" Value="#e25858" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
