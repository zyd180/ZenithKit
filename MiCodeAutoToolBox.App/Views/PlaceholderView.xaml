<UserControl x:Class="MiCodeAutoToolBox.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{StaticResource PanelBackground}" Padding="16" CornerRadius="10" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="模块占位" Foreground="{StaticResource TextMuted}" FontSize="12"/>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,4,0,6"/>
            <TextBlock x:Name="DescText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="520"/>
        </StackPanel>
    </Border>
</UserControl>
