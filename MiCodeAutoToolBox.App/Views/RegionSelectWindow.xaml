<Window x:Class="MiCodeAutoToolBox.App.Views.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#40ffffff"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="区域选择"
        Height="400" Width="600"
        Opacity="0.35">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="#20000000">
            <Rectangle x:Name="SelectionRect" Stroke="#ff3d6af2" StrokeThickness="2" Fill="#403d6af2" Visibility="Collapsed" RadiusX="2" RadiusY="2"/>
        </Canvas>
    </Grid>
</Window>
