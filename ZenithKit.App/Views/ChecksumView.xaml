<UserControl x:Class="ZenithKit.App.Views.ChecksumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Height="200">
    <Grid Background="#1e1e1e">
        <Border Padding="12">
            <StackPanel>
                <TextBlock Text="校验和" Foreground="#fff" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                    <Button Content="浏览" Width="60" Command="{Binding BrowseFileCommand}" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="120" SelectedItem="{Binding Algorithm}">
                        <ComboBoxItem Content="MD5"/>
                        <ComboBoxItem Content="SHA1"/>
                        <ComboBoxItem Content="SHA256"/>
                    </ComboBox>
                    <Button Content="计算" Width="80" Command="{Binding ComputeCommand}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBox Text="{Binding Result}" IsReadOnly="True" Margin="0,8,0,0" Height="60" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" Foreground="#7d8291" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
