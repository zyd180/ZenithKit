<UserControl x:Class="ZenithKit.App.Views.RenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Height="200">
    <Grid Background="#1e1e1e">
        <Border Padding="12">
            <StackPanel>
                <TextBlock Text="批量重命名" Foreground="#fff" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="FrameworkElement">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                        </Style>
                    </StackPanel.Resources>
                    <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                    <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                    <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <Button Content="预览" Width="80" Command="{Binding PreviewCommand}"/>
                    <Button Content="执行" Width="80" Command="{Binding RenameCommand}"/>
                </StackPanel>
                <TextBlock Text="Pattern 使用 {0} 作为序号占位" Foreground="#777" FontSize="12" Margin="0,6,0,6"/>
                <ListBox ItemsSource="{Binding Renamed}" Height="200"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
