<UserControl x:Class="ZenithKit.App.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="{StaticResource PanelBackground}" Padding="12" CornerRadius="8" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="截图" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="状态" Foreground="{StaticResource TextMuted}" FontSize="12" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>

            <Button Content="全屏截图" Width="120" Command="{Binding CaptureCommand}"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="区域截图" Width="120" Command="{Binding CaptureRegionCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Title" Width="300"/>
                <Button Content="刷新窗口" Width="100" Command="{Binding RefreshWindowsCommand}" Margin="6,0,0,0"/>
                <Button Content="窗口截图" Width="100" Command="{Binding CaptureWindowCommand}" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock Text="保存路径" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                <Button Content="浏览" Width="80" Command="{Binding BrowseSaveDirectoryCommand}" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock Text="最近保存" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding LastSavedPath}" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
